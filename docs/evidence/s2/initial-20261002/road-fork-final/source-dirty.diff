+    /**
+     * S2 wall interop: persistent idempotent endpoint registration.
+     * Returns true only on first registration; repeated calls with the
+     * same structureId+xz return false without adding duplicates.
+     */
+    public static boolean registerStructureEndpointOnce(ServerLevel level, BlockPos pos, String structureId) {
+        if (level == null || pos == null || structureId == null || structureId.isEmpty()
+                || !Level.OVERWORLD.equals(level.dimension())) {
+            return false;
+        }
+        if (!level.getServer().isSameThread()) {
+            throw new IllegalStateException("registerStructureEndpointOnce requires the server owner");
+        }
+        // Check existing storage first (idempotent across restarts).
+        StructureLocationData existing = WorldDataProvider.getInstance().getStructureLocations(level);
+        if (existing != null) {
+            for (StructureInfo info : existing.structureInfos()) {
+                if (structureId.equals(info.structureId())
+                        && info.pos().getX() == pos.getX()
+                        && info.pos().getZ() == pos.getZ()) {
+                    return false; // already registered
+                }
+            }
+        }
+        registerStructureEndpoint(level, new BlockPos(pos.getX(), 0, pos.getZ()), structureId, false);
+        return true;
+    }
+
     public static void ensureConnection(ServerLevel level, BlockPos from, BlockPos to) {
         ensureConnection(level, from, to, false);
     }
